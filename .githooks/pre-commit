#!/usr/bin/env bash
# Pre-commit: lint and test the hedy CLI when staged changes touch hedy/,
# lint the skills estate when staged changes touch .claude/ or the
# Makefile, and run the scaffold and workspace golden suites when staged
# changes touch a gated tools domain.
# Wired via `git config core.hooksPath .githooks` (make link does this).
# Tool-agnostic by design: runs for any editor or agent. Bypassing
# with --no-verify is denied by the workspace's own bash guard.
#
# Lints the STAGED INDEX, not the worktree: the content being committed
# is checked out into a temp HOME (the same seam the golden tests use),
# so an unstaged fix cannot mask a staged break and vice versa.

STAGED=$(git diff --cached --name-only)

# hedy CLI: lint and test in the WORKTREE's hedy/, not the staged copy -
# the installed packages (hedy/node_modules/, gitignored) exist only in
# the worktree. Git runs hooks from the repository root.
if echo "$STAGED" | grep -q '^hedy/'; then
    (cd hedy && npm run lint) || {
        echo "pre-commit: hedy CLI lint failed - fix and re-stage" >&2
        exit 1
    }
    (cd hedy && npm test) || {
        echo "pre-commit: hedy CLI tests failed - fix and re-stage" >&2
        exit 1
    }
fi

# Everything below applies only when the skills estate or the Makefile
# is staged. Doc-only commits stay fast.
echo "$STAGED" | grep -Eq '^(\.claude/|Makefile$)' || exit 0

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
git checkout-index --prefix="$TMP/trade-imports-arch-workspace/" -a

if ! HOME="$TMP" bash "$TMP/trade-imports-arch-workspace/.claude/tools/workspace/lint-skills.sh"; then
    echo "pre-commit: skills lint failed on the staged content - fix and re-stage" >&2
    exit 1
fi

# Golden suites run when staged paths touch a gated tools domain -
# the edit-generator-forget-to-bless failure a commit gate exists
# to catch. Both suites run for any gated domain: the scaffold's
# blessed stdout embeds lint-skills.sh output, so a workspace-side
# lint change can break scaffold goldens too.
if echo "$STAGED" | grep -Eq '^\.claude/tools/(skill-creator|workspace|pr)/'; then
    HOME="$TMP" bash "$TMP/trade-imports-arch-workspace/.claude/tools/skill-creator/tests/run-golden.sh" || {
        echo "pre-commit: scaffold goldens failed on staged content - re-bless with reviewed diffs, or fix" >&2
        exit 1
    }
    HOME="$TMP" bash "$TMP/trade-imports-arch-workspace/.claude/tools/workspace/tests/run-golden.sh" || {
        echo "pre-commit: deps-doctor goldens failed on staged content - re-bless with reviewed diffs, or fix" >&2
        exit 1
    }
fi

exit 0
