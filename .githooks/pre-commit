#!/usr/bin/env bash
# Pre-commit: lint the skills estate when staged changes touch .claude/.
# Wired via `git config core.hooksPath .githooks` (make link does this).
# Tool-agnostic by design — fires for any editor or agent. Bypassing
# with --no-verify is denied by the workspace's own bash guard.
#
# Lints the STAGED INDEX, not the worktree: the content being committed
# is checked out into a temp HOME (the same seam the golden tests use),
# so an unstaged fix can't mask a staged break and vice versa.

if git diff --cached --name-only | grep -Eq '^(\.claude/|Makefile$)'; then
    TMP=$(mktemp -d)
    trap 'rm -rf "$TMP"' EXIT
    git checkout-index --prefix="$TMP/trade-imports-arch-workspace/" -a
    if ! HOME="$TMP" bash "$TMP/trade-imports-arch-workspace/.claude/tools/workspace/lint-skills.sh"; then
        echo "pre-commit: skills lint failed on the staged content - fix and re-stage" >&2
        exit 1
    fi
    # Golden suites run when staged paths touch either tools domain —
    # the edit-generator-forget-to-bless failure a commit gate exists
    # to catch. BOTH suites run for either domain: the scaffold's
    # blessed stdout embeds lint-skills.sh output, so a workspace-side
    # lint change can break scaffold goldens too. Doc-only commits
    # stay fast.
    if git diff --cached --name-only | grep -Eq '^\.claude/tools/(skill-creator|workspace)/'; then
        HOME="$TMP" bash "$TMP/trade-imports-arch-workspace/.claude/tools/skill-creator/tests/run-golden.sh" || {
            echo "pre-commit: scaffold goldens failed on staged content - re-bless with reviewed diffs, or fix" >&2
            exit 1
        }
        HOME="$TMP" bash "$TMP/trade-imports-arch-workspace/.claude/tools/workspace/tests/run-golden.sh" || {
            echo "pre-commit: deps-doctor goldens failed on staged content - re-bless with reviewed diffs, or fix" >&2
            exit 1
        }
    fi
fi
exit 0
